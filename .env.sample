# Copy to .env and fill in what you need.
# Every variable is optional: unset ones keep config.json's value, or the
# built-in default if there is no config.json at all.

# --- server ---
COCE_PORT=8080
COCE_PROVIDERS=aws,gb,ol
COCE_TIMEOUT=8000

# --- redis ---
COCE_REDIS_HOST=redis
COCE_REDIS_PORT=6379
COCE_REDIS_TIMEOUT=5000

# --- local image cache (optional) ---
#COCE_CACHE_PATH=/covers
#COCE_CACHE_URL=https://coce.example.org/covers

# --- per-provider settings ---
#COCE_GB_TIMEOUT=86400
#COCE_AWS_TIMEOUT=86400
#COCE_AWS_IMAGE_SIZE=MediumSize
#COCE_OL_TIMEOUT=86400
#COCE_OL_IMAGE_SIZE=medium
#COCE_ORB_TIMEOUT=86400
#COCE_ORB_USER=authorized user
#COCE_ORB_KEY=api key
#COCE_ORB_CACHE=true
