{
  "port": "8080",
  "providers": ["gb","aws","ol","orb"],
  "timeout": 8000,
  "providerTimeout": 5000,
  "providerRetry": 300,
  "maxIds": 100,
  "notFoundTimeout": 86400,
  "statsDays": 30,
  "redis": {
    "host": "127.0.0.1",
    "port": 6379,
    "timeout": 500
  },
  "cache": {
    "path": "/home/myuser/covers",
    "url": "https://coce.myserver.fr/covers"
  },
  "gb": {
    "timeout": 86400
  },
  "aws": {
    "timeout": 86400
  },
  "ol": {
    "timeout": 86400,
    "imageSize": "medium"
  },
  "orb": {
    "timeout": 86400,
    "user": "authorized user",
    "key": "api key",
    "imageSize": "thumbnail",
    "cache": true
  }
}
